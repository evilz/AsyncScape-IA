<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>TUnit</id>
    <version>0.61.39</version>
    <authors>Tom Longhurst</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>logo.jpg</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/thomhurst/TUnit</projectUrl>
    <description>A .NET Testing Framework</description>
    <copyright>Copyright (c) Tom Longhurst 2025</copyright>
    <tags>testing unit integration component test assert tester framework</tags>
    <repository type="git" url="https://github.com/thomhurst/TUnit" branch="refs/heads/main" commit="f2a370e1c33539c3522a80ae4c168694a217118c" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="TUnit.Assertions" version="0.61.39" exclude="Build,Analyzers" />
        <dependency id="TUnit.Engine" version="0.61.39" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0">
        <dependency id="TUnit.Assertions" version="0.61.39" exclude="Build,Analyzers" />
        <dependency id="TUnit.Engine" version="0.61.39" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="TUnit.Assertions" version="0.61.39" exclude="Build,Analyzers" />
        <dependency id="TUnit.Engine" version="0.61.39" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>