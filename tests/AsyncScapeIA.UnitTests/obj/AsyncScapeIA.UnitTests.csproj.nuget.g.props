<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <RestoreSuccess Condition=" '$(RestoreSuccess)' == '' ">True</RestoreSuccess>
    <RestoreTool Condition=" '$(RestoreTool)' == '' ">NuGet</RestoreTool>
    <ProjectAssetsFile Condition=" '$(ProjectAssetsFile)' == '' ">$(MSBuildThisFileDirectory)project.assets.json</ProjectAssetsFile>
    <NuGetPackageRoot Condition=" '$(NuGetPackageRoot)' == '' ">E:\PROJECTS\GITHUB\AsyncScape-IA\.nuget\packages</NuGetPackageRoot>
    <NuGetPackageFolders Condition=" '$(NuGetPackageFolders)' == '' ">E:\PROJECTS\GITHUB\AsyncScape-IA\.nuget\packages;C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages</NuGetPackageFolders>
    <NuGetProjectStyle Condition=" '$(NuGetProjectStyle)' == '' ">PackageReference</NuGetProjectStyle>
    <NuGetToolVersion Condition=" '$(NuGetToolVersion)' == '' ">7.0.0</NuGetToolVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <SourceRoot Include="E:\PROJECTS\GITHUB\AsyncScape-IA\.nuget\packages\" />
    <SourceRoot Include="C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages\" />
  </ItemGroup>
  <ImportGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)\tunit.core\0.61.39\buildTransitive\net9.0\TUnit.Core.props" Condition="Exists('$(NuGetPackageRoot)\tunit.core\0.61.39\buildTransitive\net9.0\TUnit.Core.props')" />
    <Import Project="$(NuGetPackageRoot)\microsoft.testing.platform\1.8.4\buildTransitive\net9.0\Microsoft.Testing.Platform.props" Condition="Exists('$(NuGetPackageRoot)\microsoft.testing.platform\1.8.4\buildTransitive\net9.0\Microsoft.Testing.Platform.props')" />
    <Import Project="$(NuGetPackageRoot)\microsoft.testing.platform.msbuild\1.4.3\buildTransitive\net8.0\Microsoft.Testing.Platform.MSBuild.props" Condition="Exists('$(NuGetPackageRoot)\microsoft.testing.platform.msbuild\1.4.3\buildTransitive\net8.0\Microsoft.Testing.Platform.MSBuild.props')" />
    <Import Project="$(NuGetPackageRoot)\tunit.engine\0.61.39\buildTransitive\net9.0\TUnit.Engine.props" Condition="Exists('$(NuGetPackageRoot)\tunit.engine\0.61.39\buildTransitive\net9.0\TUnit.Engine.props')" />
    <Import Project="$(NuGetPackageRoot)\tunit.assertions\0.61.39\buildTransitive\net9.0\TUnit.Assertions.props" Condition="Exists('$(NuGetPackageRoot)\tunit.assertions\0.61.39\buildTransitive\net9.0\TUnit.Assertions.props')" />
  </ImportGroup>
</Project>